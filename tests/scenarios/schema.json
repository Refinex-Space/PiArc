{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piarc.cn/schemas/l2-scenario.json",
  "title": "PiArc L2 scenario",
  "description": "One L2 scenario (architecture section 12.3): workspace fixture, mock provider scripts, the actions that drive Core, approval answers and the expected events, files and requests. Field reference and matching rules: docs/engineering/testing.md section 12.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "capabilities", "providers", "actions", "expect"],
  "properties": {
    "id": {
      "description": "Equals the file name without extension.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "description": "The behavior the scenario proves, in one sentence that matches its assertions.",
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "description": "Capability ids of tests/capabilities.yaml this scenario covers.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityId" }
    },
    "platforms": {
      "description": "Platforms the scenario runs on; both when absent.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["macos", "windows"] }
    },
    "platform_reason": {
      "description": "Why a platform is left out; required when platforms excludes one.",
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "description": "Initial files: relative path (forward slashes) to UTF-8 content.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/relativePath" },
          "additionalProperties": { "type": "string" }
        },
        "run_files": {
          "description": "Initial UTF-8 files relative to the scenario's isolated temporary root.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/relativePath" },
          "additionalProperties": { "type": "string" }
        },
        "git": {
          "description": "Initialize the workspace as a Git repository.",
          "type": "boolean"
        },
        "fixtures": {
          "description": "Files copied byte for byte from the scenarios' fixtures/ directory: relative path in the workspace to the fixture's name (relative, forward slashes). For CRLF, byte order marks, legacy encodings, images and PDFs.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/relativePath" },
          "additionalProperties": { "$ref": "#/$defs/relativePath" }
        },
        "trusted": {
          "description": "Record a trust decision for the workspace before it opens; untrusted when absent.",
          "type": "boolean"
        }
      }
    },
    "web": {
      "description": "A local web server for WebFetch (T29). {{web}} in page bodies, redirect targets and tool call arguments becomes http://127.0.0.1:<port>, {{web_alt}} the same server as http://localhost:<port>; Core's WebFetch allowlist admits both for these scenarios only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pages"],
      "properties": {
        "pages": {
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^/" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "content_type": { "type": "string", "minLength": 1 },
              "body": { "type": "string" },
              "repeat": { "type": "integer", "minimum": 1 },
              "location": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "oauth": {
      "description": "A mock authorization server and the test OAuth provider piarc-test-oauth on every Agent Host (T29), signing in with this flow.",
      "type": "object",
      "additionalProperties": false,
      "required": ["flow"],
      "properties": { "flow": { "enum": ["authorization_code", "device_code"] } }
    },
    "cloud_providers": {
      "description": "Configure a cloud API key through the real settings path; model requests remain on loopback mocks.",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["amazon-bedrock", "google-vertex"] }
    },
    "providers": {
      "description": "Mock provider endpoints by name; each is its own Pi provider with one model.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/label" },
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "sessions": {
      "description": "Sessions by label; a single session `main` on the only provider when absent.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/label" },
      "additionalProperties": { "$ref": "#/$defs/session" }
    },
    "actions": {
      "description": "What the runner does, in order.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "approvals": {
      "description": "Answers to Core's approval requests, in order.",
      "type": "array",
      "items": { "$ref": "#/$defs/approval" }
    },
    "expect": { "$ref": "#/$defs/expect" }
  },
  "$defs": {
    "capabilityId": { "type": "string", "pattern": "^CAP-[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$" },
    "label": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "description": "Relative, forward slashes; the loader also rejects `..` segments and drive letters.",
      "pattern": "^[^/\\\\]"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire", "steps"],
      "properties": {
        "wire": { "description": "Wire format of the endpoint.", "enum": ["anthropic", "openai"] },
        "configure_as": {
          "description": "Configure this mock through the Core settings API.",
          "enum": ["custom", "local"]
        },
        "reasoning": {
          "description": "The imported mock model supports thinking levels.",
          "type": "boolean"
        },
        "validation": { "$ref": "#/$defs/validation" },
        "vision": {
          "description": "The endpoint's model takes images as input; text only when absent.",
          "type": "boolean"
        },
        "context_window": {
          "description": "The model's context window in tokens (T27); 200000 when absent.",
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "description": "The model's largest output in tokens (T27); 4096 when absent.",
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "description": "The endpoint's model id (T31), sent as `model` in its requests; mock-model when absent.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool_pairing": { "type": "boolean" },
            "role_order": { "type": "boolean" },
            "tool_schema": { "type": "boolean" },
            "system_sections": { "type": "boolean" },
            "cache_breakpoint_count": { "type": "boolean" },
            "cache_breakpoint_position": { "type": "boolean" }
          }
        },
        "ordered_system_sections": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_system_sections": { "type": "array", "items": { "type": "string" } },
        "cache_breakpoints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_message_level": { "type": "integer", "minimum": 0 },
            "last_message_only": { "type": "boolean" }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "thinking": { "type": "string" },
        "chunk_chars": { "type": "integer", "minimum": 1 },
        "chunk_delay_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/toolCall" } },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cache_read_tokens": { "type": "integer", "minimum": 0 },
            "cache_write_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "stop_reason": { "enum": ["end_turn", "tool_use", "max_tokens"] },
        "disconnect_after_events": { "type": "integer", "minimum": 0 },
        "stall_after_events": { "type": "integer", "minimum": 0 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["unauthorized", "rate_limit", "overloaded", "server_error", "unavailable"]
            },
            "retry_after_secs": { "type": "integer", "minimum": 0 },
            "message": { "type": "string" }
          }
        }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "fragments": { "type": "integer", "minimum": 1 },
        "split_at": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "$ref": "#/$defs/label" },
        "mode": { "enum": ["default", "acceptEdits", "plan", "bypassPermissions"] },
        "deferred": { "description": "Create the session on its first input.", "type": "boolean" },
        "cwd": {
          "description": "Working directory relative to the workspace; the workspace when absent.",
          "$ref": "#/$defs/relativePath"
        },
        "settings_model": {
          "description": "Create the session without a model: the settings' default model and effort apply (T31); provider still names the endpoint the scenario expects.",
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "prompt": { "$ref": "#/$defs/inputAction" },
        "steer": { "$ref": "#/$defs/inputAction" },
        "follow_up": { "$ref": "#/$defs/inputAction" },
        "queue_edit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["item", "text"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "item": { "$ref": "#/$defs/label" },
            "text": { "type": "string" }
          }
        },
        "queue_delete": {
          "type": "object",
          "additionalProperties": false,
          "required": ["item"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "item": { "$ref": "#/$defs/label" }
          }
        },
        "queue_reorder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/label" } }
          }
        },
        "compact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "instructions": {
              "description": "What the summary should focus on (`/compact <focus>`, T27).",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "abort": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "session": { "$ref": "#/$defs/label" } }
        },
        "wait": { "$ref": "#/$defs/waitAction" },
        "set_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "preview"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "provider": { "$ref": "#/$defs/label" },
            "preview": { "type": "object", "minProperties": 1 }
          }
        },
        "set_effort": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effort"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "effort": { "enum": ["off", "low", "medium", "high", "xhigh", "max"] }
          }
        },
        "set_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "mode": { "enum": ["default", "acceptEdits", "plan", "bypassPermissions"] }
          }
        },
        "delete_session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "$ref": "#/$defs/label"
            }
          }
        },
        "set_prefs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "$ref": "#/$defs/label"
            },
            "pinned": {
              "type": "boolean"
            },
            "archived": {
              "type": "boolean"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "check_stored_session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "$ref": "#/$defs/label"
            },
            "fields": {
              "type": ["object", "null"]
            }
          },
          "required": ["fields"]
        },
        "check_trust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "object",
              "minProperties": 1
            }
          },
          "required": ["fields"]
        },
        "restart_core": {
          "description": "Shut Core down, start it again on the same data directory and reopen the workspace; sessions stay closed until resumed.",
          "type": "object",
          "additionalProperties": false
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "session": { "$ref": "#/$defs/label" } }
        },
        "write_file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "content"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "content": { "type": "string" }
          }
        },
        "fork": {
          "description": "Forks a session at the entry of one of its agent messages (at_text, T26) or before one of its labeled turns (before_turn, T28's branch from here); the new session takes a deferred session label.",
          "type": "object",
          "additionalProperties": false,
          "required": ["as"],
          "oneOf": [{ "required": ["at_text"] }, { "required": ["before_turn"] }],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "at_text": { "type": "string", "minLength": 1 },
            "before_turn": { "$ref": "#/$defs/label" },
            "as": { "$ref": "#/$defs/label" }
          }
        },
        "sign_in": {
          "description": "Signs in to the test OAuth provider (T29): the runner follows the authorization page's redirect like a browser, or cancels at the first step; checks the final core/login state, its message and whether the provider is signed in afterwards.",
          "type": "object",
          "additionalProperties": false,
          "required": ["behavior", "outcome"],
          "properties": {
            "behavior": { "enum": ["approve", "deny", "expire"] },
            "cancel": { "type": "boolean" },
            "outcome": { "enum": ["succeeded", "failed", "cancelled"] },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "sign_out": {
          "description": "Signs out of the test OAuth provider (T29).",
          "type": "object",
          "additionalProperties": false
        },
        "check_usage": {
          "description": "Checks the session's context usage from Core (T27): its categories add up to tokens (always), a field subset, and categories that must be above zero.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "fields": { "type": "object" },
            "positive": {
              "type": "array",
              "items": {
                "enum": [
                  "systemPrompt",
                  "tools",
                  "mcpTools",
                  "memory",
                  "skills",
                  "conversation",
                  "toolResults",
                  "unclassified"
                ]
              }
            }
          }
        },
        "check_harness": {
          "description": "Checks a field subset of the plan and task list of the session's branch (session/history harness), or their absence when fields is null (T26).",
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "fields": { "type": ["object", "null"] }
          }
        },
        "rewind": {
          "description": "Rewinds a session to before one of its labeled turns (T28): checks the preview (every file by its workspace-relative label), answers each conflict (choices), then checks the report; cancel stops after the preview.",
          "type": "object",
          "additionalProperties": false,
          "required": ["turn", "scope"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "turn": { "$ref": "#/$defs/label" },
            "scope": { "enum": ["codeAndConversation", "conversation", "code", "summarize"] },
            "preview": {
              "type": "object",
              "additionalProperties": { "enum": ["restore", "delete", "unchanged", "conflict"] }
            },
            "choices": { "type": "object", "additionalProperties": { "type": "boolean" } },
            "cancel": { "type": "boolean" },
            "outcomes": {
              "type": "object",
              "additionalProperties": {
                "enum": ["restored", "deleted", "unchanged", "kept", "failed", "skipped"]
              }
            },
            "completed": { "type": "boolean" },
            "text": { "type": "string" }
          }
        },
        "undo_rewind": {
          "description": "Undoes the session's latest rewind (T28) and checks each file's outcome.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "outcomes": {
              "type": "object",
              "additionalProperties": {
                "enum": ["restored", "deleted", "unchanged", "kept", "failed", "skipped"]
              }
            }
          }
        },
        "check_changes": {
          "description": "Checks a field subset of the session's Changes view (T28): files in the order the session first wrote them, line counts, degradation.",
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "fields": { "type": "object" }
          }
        },
        "discard": {
          "description": "Discards a file's change, or one hunk of it, in the Changes panel (T28); stale sends an outdated version, which must be refused.",
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "path": { "$ref": "#/$defs/relativePath" },
            "hunk": { "type": "integer", "minimum": 0 },
            "stale": { "type": "boolean" }
          }
        },
        "switch_branch": {
          "description": "Continues the session on the branch whose first user message starts with to (T28).",
          "type": "object",
          "additionalProperties": false,
          "required": ["to"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "to": { "type": "string", "minLength": 1 }
          }
        },
        "check_branch": {
          "description": "Checks the user and agent message texts of the session's current branch in order, and a field subset of its branch points (null: none) (T28).",
          "type": "object",
          "additionalProperties": false,
          "required": ["texts"],
          "properties": {
            "session": { "$ref": "#/$defs/label" },
            "texts": { "type": "array", "items": { "type": "string" } },
            "branches": { "type": ["array", "null"] }
          }
        },
        "check_files": {
          "description": "Checks workspace files in the middle of the actions (T28): content, or null for absent.",
          "type": "object",
          "additionalProperties": false,
          "required": ["files"],
          "properties": {
            "files": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
          }
        }
      },
      "additionalProperties": false
    },
    "inputAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "session": { "$ref": "#/$defs/label" },
        "text": { "type": "string", "minLength": 1 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "start", "end"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixture", "mime_type"],
            "properties": {
              "fixture": { "$ref": "#/$defs/relativePath" },
              "mime_type": { "type": "string", "minLength": 1 }
            }
          }
        },
        "turn": { "description": "Label for the turn the input started.", "$ref": "#/$defs/label" },
        "item": { "description": "Label for the queue item it became.", "$ref": "#/$defs/label" },
        "rejected": {
          "description": "Core must refuse the input with an error containing this text (a UserPromptSubmit hook, T25).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "waitAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "session": { "$ref": "#/$defs/label" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "turn": { "$ref": "#/$defs/label" },
        "count": {
          "description": "Wait until this many matching events arrived.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "eventMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "session": { "$ref": "#/$defs/label" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "description": "Field subset of the event's params.", "type": "object" },
        "turn": {
          "description": "params.turnId is the turn with this label.",
          "$ref": "#/$defs/label"
        }
      }
    },
    "eventGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any_order"],
      "properties": {
        "any_order": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/eventMatcher" } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "kind": { "enum": ["command", "fileChange", "permissionExpansion", "question", "plan"] },
        "feedback": { "type": "string" },
        "mode": {
          "description": "The mode an approved plan continues in (T26).",
          "enum": ["default", "acceptEdits"]
        },
        "comments": {
          "description": "Inline comments sent with a declined plan, anchored at the first occurrence of quote (T26).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quote", "text"],
            "properties": {
              "quote": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "subagent": {
          "description": "The card must come from a subagent of this type (and description) (T31).",
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "description": { "type": "string" }
          }
        },
        "answers": {
          "description": "One answer per question of a question card (T26).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "selected": { "type": "array", "items": { "type": "string" } },
              "other": { "type": "string" }
            }
          }
        },
        "decision": {
          "description": "wait leaves the card unanswered: a question form whose timeout answers it (T26).",
          "enum": ["allow", "deny", "always", "session", "wait"]
        },
        "tool": {
          "description": "The canonical tool name the request must be for.",
          "type": "string"
        },
        "call": {
          "description": "The tool call id the request must be for; L3 runs answer each request with the approval naming its call (T30).",
          "type": "string"
        }
      }
    },
    "requestExpect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index"],
      "properties": {
        "provider": { "$ref": "#/$defs/label" },
        "index": {
          "description": "Request number of the endpoint, from 0.",
          "type": "integer",
          "minimum": 0
        },
        "roles": { "type": "array", "items": { "type": "string" } },
        "tools": {
          "description": "Exactly these tool names, in any order.",
          "type": "array",
          "items": { "type": "string" }
        },
        "tools_include": { "type": "array", "items": { "type": "string" } },
        "tools_exclude": { "type": "array", "items": { "type": "string" } },
        "user_texts": { "type": "array", "items": { "type": "string" } },
        "last_user_text": { "type": "string" },
        "contains": { "type": "array", "items": { "type": "string" } },
        "not_contains": { "type": "array", "items": { "type": "string" } },
        "occurrences": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "user_message_contains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "same_system_as": { "type": "integer", "minimum": 0 },
        "same_tools_as": {
          "description": "Compare the tool definitions byte for byte with an earlier request on the same endpoint (T26).",
          "type": "integer",
          "minimum": 0
        },
        "tool_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "is_error": { "type": "boolean" },
              "contains": { "type": "string" }
            }
          }
        },
        "body": { "description": "Field subset of the request body.", "type": "object" }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "events": {
          "description": "Ordered subsequence per session; each item a field subset.",
          "type": "array",
          "items": {
            "oneOf": [{ "$ref": "#/$defs/eventMatcher" }, { "$ref": "#/$defs/eventGroup" }]
          }
        },
        "files": {
          "description": "Workspace files after the run: exact content, or null for absent.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/relativePath" },
          "additionalProperties": { "type": ["string", "null"] }
        },
        "requests": { "type": "array", "items": { "$ref": "#/$defs/requestExpect" } },
        "configured_providers": {
          "description": "Assert public fields and chat model availability for each configured provider.",
          "type": "object",
          "additionalProperties": { "type": "object", "minProperties": 1 }
        },
        "request_counts": {
          "description": "Exact number of requests each endpoint received.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/label" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "tool_batches": {
          "description": "Tool call ids in the batches their Core requests arrive in.",
          "type": "array",
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "fixtures": {
          "description": "Workspace files after the run whose bytes equal a fixture file: relative path to the fixture's name.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/relativePath" },
          "additionalProperties": { "$ref": "#/$defs/relativePath" }
        },
        "config_diagnostics": {
          "description": "Subset of Core's configuration diagnostics of the workspace after the run (T24): `trusted`, and `files` keyed by layer id, each a subset of that file's report (status, effective, overridden, ignored, issues; lists compare element by element).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trusted": { "type": "boolean" },
            "files": { "type": "object", "additionalProperties": { "type": "object" } }
          }
        },
        "core_io": {
          "description": "Core answered a request with this method for this tool call.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["call", "method"],
            "properties": { "call": { "type": "string" }, "method": { "type": "string" } }
          }
        },
        "json_lines": {
          "description": "Workspace files of JSON lines after the run (hook fixtures record their stdin, T25): exactly this many lines, each a field subset.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/relativePath" },
          "additionalProperties": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
