{
  "$defs": {
    "AgentMessageDeltaParams": {
      "description": "Parameters of `item/agentMessage/delta`.",
      "properties": {
        "delta": {
          "description": "Text to append.",
          "type": "string"
        },
        "itemId": {
          "$ref": "#/$defs/ItemId",
          "description": "The `agentMessage` item being extended."
        },
        "seq": {
          "description": "Sequence number, monotonically increasing within the session.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId",
          "description": "The session the event belongs to."
        },
        "ts": {
          "description": "Time the event was produced, in milliseconds since the Unix epoch (UTC).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "turnId": {
          "$ref": "#/$defs/TurnId",
          "description": "The turn the item belongs to."
        }
      },
      "required": ["sessionId", "seq", "ts", "turnId", "itemId", "delta"],
      "type": "object"
    },
    "Capability": {
      "description": "A named optional protocol feature, for example `planMode`.\n\nCapabilities are open strings rather than an enum: a peer must accept capability names\nit does not know, because that is how newer minor versions announce additions.",
      "type": "string"
    },
    "CoreWelcome": {
      "description": "Result of `host/hello` (`core/welcome`).",
      "properties": {
        "connectionEpoch": {
          "description": "Incremented every time Core (re)starts an Agent Host for the workspace; lets both\nsides tell connections apart after a restart.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "description": "Capabilities enabled for this connection: the intersection of both sides.",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "Protocol version spoken by Core."
        },
        "workspace": {
          "description": "Absolute path of the workspace this Agent Host serves.",
          "type": "string"
        }
      },
      "required": ["protocol", "enabled", "workspace", "connectionEpoch"],
      "type": "object"
    },
    "ErrorData": {
      "description": "Structured part of an [`ErrorObject`].",
      "properties": {
        "details": {
          "description": "Optional kind-specific details."
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind",
          "description": "Machine-readable error category."
        },
        "retryable": {
          "description": "Whether repeating the same request could succeed.",
          "type": "boolean"
        }
      },
      "required": ["kind", "retryable"],
      "type": "object"
    },
    "ErrorKind": {
      "description": "Machine-readable error categories.\n\nAdding a variant is not backward compatible for receivers on an older minor version;\nsee the crate documentation on compatibility.",
      "oneOf": [
        {
          "const": "parseError",
          "description": "Invalid JSON or invalid UTF-8 was received.",
          "type": "string"
        },
        {
          "const": "invalidRequest",
          "description": "The message is not a valid AHP JSON-RPC message (including batches).",
          "type": "string"
        },
        {
          "const": "methodNotFound",
          "description": "The method does not exist or is not available.",
          "type": "string"
        },
        {
          "const": "invalidParams",
          "description": "The method parameters are invalid.",
          "type": "string"
        },
        {
          "const": "internalError",
          "description": "An unexpected internal failure.",
          "type": "string"
        },
        {
          "const": "protocolVersionMismatch",
          "description": "The peers' major protocol versions differ.",
          "type": "string"
        },
        {
          "const": "frameTooLarge",
          "description": "A frame exceeded the receiver's size limit.",
          "type": "string"
        },
        {
          "const": "shuttingDown",
          "description": "The receiver is shutting down and no longer accepts requests. Core API only: not\nsent over AHP until a capability introduces it.",
          "type": "string"
        },
        {
          "const": "busy",
          "description": "The receiver's queue is full; retrying later can succeed. Core API only: not sent\nover AHP until a capability introduces it.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "No response arrived within the request's timeout; whether the request took effect is\nunknown.",
          "type": "string"
        },
        {
          "const": "uncertain",
          "description": "The connection to the Agent Host ended before the request reached a final state; it\nmay or may not have taken effect, and it is not replayed. Core API only.",
          "type": "string"
        },
        {
          "const": "hostUnavailable",
          "description": "The Agent Host is not connected: it is starting, restarting or stopped. Core API only.",
          "type": "string"
        },
        {
          "const": "sessionNotFound",
          "description": "No open session has the given id.",
          "type": "string"
        },
        {
          "const": "sessionBusy",
          "description": "The session is running a turn and cannot start another one yet.",
          "type": "string"
        }
      ]
    },
    "ErrorObject": {
      "description": "JSON-RPC 2.0 error object with PiArc's mandatory structured `data`.",
      "properties": {
        "code": {
          "description": "Error code; see [`code`] for the standard and application ranges.",
          "format": "int64",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/ErrorData",
          "description": "Structured, machine-readable error data."
        },
        "message": {
          "description": "Human-readable description. Not meant for branching.",
          "type": "string"
        }
      },
      "required": ["code", "message", "data"],
      "type": "object"
    },
    "ErrorResponse": {
      "description": "An error response. It has `error` and must not have `result`.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorObject",
          "description": "The structured error."
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The id of the request being answered; `null` when it could not be determined (for\nexample a parse error). The member itself is required."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "result": false
      },
      "required": ["jsonrpc", "id", "error"],
      "type": "object"
    },
    "HostHelloParams": {
      "description": "Parameters of `host/hello`.",
      "properties": {
        "capabilities": {
          "description": "Capabilities the Agent Host supports.",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        },
        "pi": {
          "description": "Version of the Pi SDK the Agent Host runs.",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "Protocol version spoken by the Agent Host."
        }
      },
      "required": ["protocol", "pi", "capabilities"],
      "type": "object"
    },
    "HostHelloRequest": {
      "description": "Request for `host/hello`.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "host/hello",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/HostHelloParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "type": "object"
    },
    "HostHelloResponse": {
      "description": "Successful response to `host/hello`.",
      "properties": {
        "error": false,
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": {
          "$ref": "#/$defs/CoreWelcome"
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "type": "object"
    },
    "HostPingParams": {
      "description": "Parameters of `host/ping`.",
      "properties": {
        "sentAt": {
          "description": "Core's send time in milliseconds since the Unix epoch, echoed in the result.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["sentAt"],
      "type": "object"
    },
    "HostPingRequest": {
      "description": "Request for `host/ping`.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "host/ping",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/HostPingParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "type": "object"
    },
    "HostPingResponse": {
      "description": "Successful response to `host/ping`.",
      "properties": {
        "error": false,
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": {
          "$ref": "#/$defs/HostStatus"
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "type": "object"
    },
    "HostShutdownParams": {
      "description": "Parameters of `host/shutdown`.",
      "properties": {
        "reason": {
          "description": "Why Core asks the Agent Host to exit, for its log (for example `idle` or `appQuit`).",
          "type": "string"
        }
      },
      "required": ["reason"],
      "type": "object"
    },
    "HostShutdownRequest": {
      "description": "Request for `host/shutdown`.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "host/shutdown",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/HostShutdownParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "type": "object"
    },
    "HostShutdownResponse": {
      "description": "Successful response to `host/shutdown`.",
      "properties": {
        "error": false,
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": {
          "$ref": "#/$defs/HostShutdownResult"
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "type": "object"
    },
    "HostShutdownResult": {
      "description": "Result of `host/shutdown`, sent once every session is closed and before the process\nexits.",
      "properties": {
        "closedSessions": {
          "description": "Number of sessions that were closed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["closedSessions"],
      "type": "object"
    },
    "HostStatus": {
      "description": "Result of `host/ping`: liveness plus resource counters of the Agent Host.",
      "properties": {
        "outboundPeakBytes": {
          "description": "Highest `outboundQueuedBytes` since the process started.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outboundQueuedBytes": {
          "description": "Bytes of those frames.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outboundQueuedFrames": {
          "description": "Frames waiting to be written to stdout right now.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rssBytes": {
          "description": "Resident set size of the Agent Host process, in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sentAt": {
          "description": "`sentAt` of the ping being answered.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sessions": {
          "description": "Number of open sessions.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sentAt",
        "rssBytes",
        "outboundQueuedFrames",
        "outboundQueuedBytes",
        "outboundPeakBytes",
        "sessions"
      ],
      "type": "object"
    },
    "Item": {
      "description": "An item in its current state, discriminated by the `type` member. Every variant\ncarries `itemId` and `status`.",
      "oneOf": [
        {
          "description": "Text produced by the agent.",
          "properties": {
            "itemId": {
              "$ref": "#/$defs/ItemId",
              "description": "The item's identifier."
            },
            "status": {
              "$ref": "#/$defs/ItemStatus",
              "description": "Lifecycle state."
            },
            "text": {
              "description": "The message text accumulated so far (complete in `item/completed`).",
              "type": "string"
            },
            "type": {
              "const": "agentMessage",
              "type": "string"
            }
          },
          "required": ["type", "itemId", "status", "text"],
          "type": "object"
        },
        {
          "description": "A tool call without a specialised item type.",
          "properties": {
            "arguments": {
              "additionalProperties": true,
              "description": "The arguments the tool was called with.",
              "type": "object"
            },
            "itemId": {
              "$ref": "#/$defs/ItemId",
              "description": "The item's identifier: the tool call id."
            },
            "output": {
              "description": "The text the tool returned, in `item/completed`.",
              "type": ["string", "null"]
            },
            "status": {
              "$ref": "#/$defs/ItemStatus",
              "description": "Lifecycle state."
            },
            "tool": {
              "description": "The tool's name.",
              "type": "string"
            },
            "type": {
              "const": "dynamicToolCall",
              "type": "string"
            }
          },
          "required": ["type", "itemId", "status", "tool", "arguments"],
          "type": "object"
        }
      ]
    },
    "ItemAgentMessageDeltaNotification": {
      "description": "Notification `item/agentMessage/delta`.",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "item/agentMessage/delta",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AgentMessageDeltaParams"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "type": "object"
    },
    "ItemCompletedNotification": {
      "description": "Notification `item/completed`.",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "item/completed",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ItemEventParams"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "type": "object"
    },
    "ItemEventParams": {
      "description": "Parameters of `item/started` and `item/completed`.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Item",
          "description": "The item's state: `inProgress` when started, final when completed."
        },
        "seq": {
          "description": "Sequence number, monotonically increasing within the session.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId",
          "description": "The session the event belongs to."
        },
        "ts": {
          "description": "Time the event was produced, in milliseconds since the Unix epoch (UTC).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "turnId": {
          "$ref": "#/$defs/TurnId",
          "description": "The turn the item belongs to."
        }
      },
      "required": ["sessionId", "seq", "ts", "turnId", "item"],
      "type": "object"
    },
    "ItemId": {
      "description": "Item identifier, unique within a session.",
      "type": "string"
    },
    "ItemStartedNotification": {
      "description": "Notification `item/started`.",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "item/started",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ItemEventParams"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "type": "object"
    },
    "ItemStatus": {
      "description": "Lifecycle state of an item.",
      "oneOf": [
        {
          "const": "inProgress",
          "description": "Started and not finished yet.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "Finished successfully.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Finished with an error.",
          "type": "string"
        },
        {
          "const": "declined",
          "description": "Rejected by the user or by policy before it ran.",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "Stopped because the turn was aborted.",
          "type": "string"
        }
      ]
    },
    "JsonRpcVersion": {
      "const": "2.0",
      "type": "string"
    },
    "ModelRef": {
      "description": "Selects a model by provider id and model id, for example `anthropic` / `claude-opus-5-5`.",
      "properties": {
        "id": {
          "description": "Model id within the provider.",
          "type": "string"
        },
        "provider": {
          "description": "Provider id.",
          "type": "string"
        }
      },
      "required": ["provider", "id"],
      "type": "object"
    },
    "Notification": {
      "description": "A notification (no `id`, no response) whose method is not interpreted.",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "method": {
          "description": "Method name, for example `turn/started`.",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "Named parameters. When present it must be an object (`null` is rejected).",
          "type": "object"
        }
      },
      "required": ["jsonrpc", "method"],
      "type": "object"
    },
    "PromptAccepted": {
      "description": "Result of `session/prompt`: the turn was accepted and will report `turn/started` and\n`turn/completed` with this id.",
      "properties": {
        "turnId": {
          "$ref": "#/$defs/TurnId",
          "description": "The turn running the prompt."
        }
      },
      "required": ["turnId"],
      "type": "object"
    },
    "ProtocolVersion": {
      "description": "Protocol version as \"major.minor\", for example \"1.0\".",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Request": {
      "description": "A request whose method is not interpreted.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "Correlates the response with this request."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "method": {
          "description": "Method name, for example `host/hello`.",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "Named parameters. When present it must be an object (`null` is rejected).",
          "type": "object"
        }
      },
      "required": ["jsonrpc", "id", "method"],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "description": "Integer id.",
          "format": "int64",
          "type": "integer"
        },
        {
          "description": "String id.",
          "type": "string"
        }
      ],
      "description": "A request id: an integer or a string. `null` and fractional numbers are not accepted."
    },
    "SessionAbortRequest": {
      "description": "Request for `session/abort`.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "session/abort",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/SessionTarget"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "type": "object"
    },
    "SessionAbortResponse": {
      "description": "Successful response to `session/abort`.",
      "properties": {
        "error": false,
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": {
          "$ref": "#/$defs/SessionStopped"
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "type": "object"
    },
    "SessionCloseRequest": {
      "description": "Request for `session/close`.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "session/close",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/SessionTarget"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "type": "object"
    },
    "SessionCloseResponse": {
      "description": "Successful response to `session/close`.",
      "properties": {
        "error": false,
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": {
          "$ref": "#/$defs/SessionStopped"
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "type": "object"
    },
    "SessionCreateParams": {
      "description": "Parameters of `session/create`.",
      "properties": {
        "cwd": {
          "description": "Absolute working directory of the session: tools resolve relative paths against it.",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Model to start with; the Agent Host's configured default when absent."
        }
      },
      "required": ["cwd"],
      "type": "object"
    },
    "SessionCreateRequest": {
      "description": "Request for `session/create`.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "method": {
          "const": "session/create",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/SessionCreateParams"
        }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "type": "object"
    },
    "SessionCreateResponse": {
      "description": "Successful response to `session/create`.",
      "properties": {
        "error": false,
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": {
          "$ref": "#/$defs/SessionOpened"
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "type": "object"
    },
    "SessionEventNotification": {
      "description": "Any session notification, read without interpreting its method: header plus payload.\nCore uses it to track `seq` for every session event.",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "method": {
          "description": "The event type, for example `item/completed`.",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/SessionEventParams",
          "description": "Header and payload."
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "type": "object"
    },
    "SessionEventParams": {
      "additionalProperties": true,
      "description": "`params` of a session notification: the header plus the method-specific payload.",
      "properties": {
        "seq": {
