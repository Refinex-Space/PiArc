{
  "permissions": {
    "deny": ["Bash(curl *)", "WebFetch(domain:paste.example.com)"],
    "ask": ["Bash(git push *)"],
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "echo managed" }] }
    ]
  },
  "deniedMcpServers": [{ "serverName": "untrusted-db" }],
  "sandbox": {
    "network": { "allowManagedDomainsOnly": true, "allowedDomains": ["registry.npmjs.org"] }
  },
  "cleanupPeriodDays": 30,
  "forceLoginMethod": "console",
  "companyAnnouncements": ["Welcome"],
  "strictKnownMarketplaces": []
}
