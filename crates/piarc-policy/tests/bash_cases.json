{
  "_comment": "T23 Bash analysis cases. Each case: category, input, split (commands in source order; 'shadow: ' marks a command another one runs; '…' is text computed at run time), rules, optional mode (default, acceptEdits, plan, bypassPermissions), expected outcome and step. The workspace and starting directory are /w, home is /h.",
  "cases": [
    {
      "category": "simple",
      "input": "echo \"a && b; c | d\"",
      "split": ["echo a && b; c | d"],
      "expected": "allow",
      "step": "readOnly"
    },
    {
      "category": "simple",
      "input": "echo 'rm -rf /; x' && ls",
      "split": ["echo rm -rf /; x", "ls"],
      "expected": "allow",
      "step": "readOnly"
    },
    {
      "category": "simple",
      "input": "grep -n \"foo\\\\|bar\" src/a.txt",
      "split": ["grep -n foo\\|bar src/a.txt"],
      "expected": "allow",
      "step": "readOnly"
    },
    {
      "category": "simple",
      "input": "cat \"my file.txt\" 文档/说明.md",
      "split": ["cat my file.txt 文档/说明.md"],
      "expected": "allow",
      "step": "readOnly"
    },
    {
      "category": "simple",
      "input": "ls a\\ b",
      "split": ["ls a b"],
      "expected": "allow",
      "step": "readOnly"
    },
    {
      "category": "simple",
      "input": "npm   run   \"build\"",
      "split": ["npm run build"],
      "rules": { "allow": ["Bash(npm run build)"] },
      "expected": "allow",
      "step": "allowRule"
    },
    {
      "category": "simple",
      "input": "git 'push' origin main",
      "split": ["git push origin main"],
      "rules": { "deny": ["Bash(git push *)"], "allow": ["Bash(git *)"] },
      "expected": "deny",
      "step": "denyRule"
    },

    {
      "category": "operators",
      "input": "ls && rm -rf build",
