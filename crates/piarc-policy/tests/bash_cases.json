      "rules": { "deny": ["Bash(rm *)"] },
      "expected": "deny",
      "step": "denyRule"
    },
    {
      "category": "operators",
      "input": "ls || echo none",
      "split": ["ls", "echo none"],
      "expected": "allow",
      "step": "readOnly"
    },
    {
      "category": "operators",
      "input": "ls; npm test",
      "split": ["ls", "npm test"],
      "expected": "ask",
      "step": "ask"
    },
    {
      "category": "operators",
