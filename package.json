{
  "name": "piarc",
  "private": true,
  "description": "PiArc desktop coding agent: Electron client, Rust core and Pi-based agent host.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "agent-host",
    "packages/protocol",
    "packages/testkit"
  ],
  "scripts": {
    "verify": "node scripts/dev/verify.mjs",
    "gen:protocol": "node scripts/dev/gen-protocol.mjs",
    "gen:tokens": "node scripts/dev/gen-design-tokens.mjs",
    "build:core": "node scripts/dev/build-core.mjs",
    "build:agent-host": "node scripts/dev/build-agent-host.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "package:desktop": "node scripts/dev/package-desktop.mjs",
    "check:fuses": "node scripts/ci/check-fuses.mjs",
    "audit:deps": "node scripts/ci/audit-deps.mjs",
    "bench:s1": "node scripts/bench/s1-transcript.mjs",
    "bench:t19": "playwright test --config apps/desktop/e2e/t19.bench.config.ts",
    "bench:t18": "node scripts/bench/t18-cold-start.mjs",
    "bench:s2": "node scripts/bench/s2-event-channel.mjs",
    "bench:s7": "node scripts/bench/s7-terminal.mjs",
    "perf:m3": "node scripts/perf/m3-memory.mjs",
    "l3": "node scripts/l3/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/cli": "3.10.12",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.0"
  }
}
