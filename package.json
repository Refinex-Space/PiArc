{
  "name": "piarc",
  "private": true,
  "description": "PiArc desktop coding agent: Electron client, Rust core and Pi-based agent host.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "agent-host",
    "packages/protocol"
  ],
  "scripts": {
    "verify": "node scripts/dev/verify.mjs",
