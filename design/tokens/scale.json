{
  "$description": "Mode-independent values: system font stacks (no bundled fonts, architecture section 8.6), type sizes, radii, motion; and the values that change with density.",
  "font": {
    "ui": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI Variable Text\", \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei UI\", system-ui, sans-serif",
