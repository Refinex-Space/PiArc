root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.toml]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

# CRLF test fixtures are kept byte-for-byte (see docs/engineering/testing.md).
[**/fixtures/crlf/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
