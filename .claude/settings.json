{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(cargo *)",
      "Bash(rustc --version)",
      "Bash(rustup show *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git grep *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git describe *)",
      "Bash(git -C reference/* *)",
      "Bash(jq *)",
      "Bash(.tools/bin/cargo-deny check *)",
      "Bash(npm view *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)",
      "Edit(./packages/protocol/src/generated/**)",
      "Write(./packages/protocol/src/generated/**)"
    ]
  }
}
