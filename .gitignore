# PiArc .gitignore
# Monorepo: Electron desktop app (apps/desktop), Rust core (cargo + NAPI-RS),
# agent host (TypeScript/Node). Keep rules grouped by toolchain.

# ---------------------------------------------------------------------------
# Local read-only reference repositories (see docs/research/REFERENCES.md).
# Cloned locally for design study; never committed, never copied into source.
# ---------------------------------------------------------------------------
/reference/

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.code-workspace
.fleet/
.zed/

# ---------------------------------------------------------------------------
# Secrets & local config (never commit credentials)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
# Local overrides for Claude Code / Pi / PiArc tooling
.claude/settings.local.json
.piarc/settings.local.json
.pi/settings.local.json

# ---------------------------------------------------------------------------
# Electron desktop app (apps/desktop)
# ---------------------------------------------------------------------------
# Forge / Vite build and packaging output
.vite/
apps/desktop/out/
apps/desktop/release/
# Compiled NAPI-RS native modules (built per target in CI)
*.node
# Release packaging output
*.dmg
# ...except the fake artefacts the release manifest tests verify
!crates/piarc-core/tests/fixtures/release/*.dmg
*.pkg
*.blockmap
*.nupkg
# Notarization scratch
notarization-*.json

# Platform-specific native helpers (apps/desktop/native), if any are written in Swift
xcuserdata/
DerivedData/
.build/
.swiftpm/
*.dSYM
*.dSYM.zip

# ---------------------------------------------------------------------------
# Rust (crates/)
# ---------------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb
# Cargo.lock is committed: this workspace ships binaries/libraries inside an app.

# ---------------------------------------------------------------------------
# Node / TypeScript (agent-host/, scripts/)
# ---------------------------------------------------------------------------
node_modules/
dist/
out/
.turbo/
.cache/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
# Bundled sidecar runtime artifacts (produced by the build, not hand-edited)
agent-host/runtime/
agent-host/bin/

# ---------------------------------------------------------------------------
# Windows packaging output and tooling
# ---------------------------------------------------------------------------
.vs/
*.msix
*.msixbundle
*.appx

# ---------------------------------------------------------------------------
# Logs, test and profiling output
# ---------------------------------------------------------------------------
*.log
logs/
*.trace
*.profraw
*.profdata
test-results/
.artifacts/
tmp/

# Repository-local developer tools (scripts/dev/install-tools.mjs)
/.tools/
