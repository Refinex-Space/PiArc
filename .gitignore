# PiArc .gitignore
# Monorepo: macOS app (Swift/Xcode), Rust core (cargo), agent host (TypeScript/Node),
# future Windows app (C#/WinUI). Keep rules grouped by toolchain.

# ---------------------------------------------------------------------------
# Local read-only reference repositories (see docs/research/REFERENCES.md).
# Cloned locally for design study; never committed, never copied into source.
# ---------------------------------------------------------------------------
/reference/

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.code-workspace
.fleet/
.zed/

# ---------------------------------------------------------------------------
# Secrets & local config (never commit credentials)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
# Local overrides for Claude Code / Pi / PiArc tooling
.claude/settings.local.json
.piarc/settings.local.json
.pi/settings.local.json

# ---------------------------------------------------------------------------
# Swift / Xcode (apps/macos)
# ---------------------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
timeline.xctimeline
playground.xcworkspace
.build/
.swiftpm/
# Generated UniFFI Swift bindings and the packaged Rust xcframework
apps/macos/**/Generated/
*.xcframework
# Release packaging output
*.dmg
*.pkg
build/
# Sparkle / notarization scratch
*.zip.sig
notarization-*.json

# ---------------------------------------------------------------------------
# Rust (crates/)
# ---------------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb
# Cargo.lock is committed: this workspace ships binaries/libraries inside an app.

# ---------------------------------------------------------------------------
# Node / TypeScript (agent-host/, scripts/)
# ---------------------------------------------------------------------------
node_modules/
dist/
out/
.turbo/
.cache/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
# Bundled sidecar runtime artifacts (produced by the build, not hand-edited)
agent-host/runtime/
agent-host/bin/

# ---------------------------------------------------------------------------
# Windows (apps/windows, phase 2)
# ---------------------------------------------------------------------------
# Scoped to apps/windows so Rust `src/bin/` directories stay tracked.
apps/windows/**/[Bb]in/
apps/windows/**/[Oo]bj/
.vs/
*.user
*.suo
*.userprefs
*.msix
*.msixbundle
*.appx
AppPackages/
BundleArtifacts/

# ---------------------------------------------------------------------------
# Logs, test and profiling output
# ---------------------------------------------------------------------------
*.log
logs/
*.trace
*.profraw
*.profdata
test-results/
.artifacts/
tmp/
