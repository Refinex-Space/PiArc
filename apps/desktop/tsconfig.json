{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Solution file for the desktop app. Each process gets its own project so the main process
  // and preload never see DOM types and the renderer never sees Node types (ADR-0013).
  "files": [],
  "references": [
    { "path": "src/shared" },
    { "path": "src/main" },
    { "path": "src/preload" },
    { "path": "src/renderer" },
    { "path": "src/browser-host" },
    { "path": "e2e" },
    { "path": "tsconfig.config.json" }
  ]
}
