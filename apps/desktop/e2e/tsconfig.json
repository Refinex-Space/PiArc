{
  "extends": "../../../tsconfig.base.json",
  // L4 Playwright tests: Node for the runner, DOM for callbacks evaluated in the page.
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "../dist/e2e",
    "tsBuildInfoFile": "../dist/e2e/.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "references": [{ "path": "../src/shared" }]
}
