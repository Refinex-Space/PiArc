{
  "extends": "../../../../tsconfig.base.json",
  // Code shared by the main process, preload and renderer: no DOM and no Node types.
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "../../dist/shared",
    "tsBuildInfoFile": "../../dist/shared/.tsbuildinfo",
    "lib": ["ES2024"],
    "types": []
  },
  "include": ["**/*.ts"]
}
